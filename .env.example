# --- Compose settings ---
COMFYUI_TAG=latest          # latest, or a ComfyUI version such as 0.38.0
COMFYUI_HOST_PORT=8188
COMFYUI_DATA=./data         # models, custom_nodes, input, output, user settings live here
PUID=1000
PGID=1000
# NVIDIA_VISIBLE_DEVICES=all

# --- ComfyUI settings (all optional) ---
# COMFYUI_LISTEN=0.0.0.0
# COMFYUI_PORT=8188                 # in-container port; keep in sync with the compose port mapping
# COMFYUI_CPU=auto                  # auto | true | false
# COMFYUI_VRAM_MODE=                # gpu-only | highvram | normalvram | lowvram | novram
# COMFYUI_CUDA_DEVICE=              # e.g. 0 or 0,1
# COMFYUI_RESERVE_VRAM=             # GB to keep free
# COMFYUI_ATTENTION=                # pytorch | split | quad | sage | flash
# COMFYUI_PREVIEW_METHOD=           # none | auto | latent2rgb | taesd
# COMFYUI_FAST=                     # e.g. fp16_accumulation (see `--fast` upstream)
# COMFYUI_CACHE_LRU=
# COMFYUI_MAX_UPLOAD_SIZE=100       # MB
# COMFYUI_CORS_ORIGIN=
# COMFYUI_TLS_KEYFILE=
# COMFYUI_TLS_CERTFILE=
# COMFYUI_EXTRA_MODEL_PATHS_CONFIG=
# COMFYUI_ENABLE_MANAGER=true
# COMFYUI_FORCE_FP16=false
# COMFYUI_FORCE_FP32=false
# COMFYUI_DISABLE_SMART_MEMORY=false
# COMFYUI_DISABLE_CUDA_MALLOC=false
# COMFYUI_DETERMINISTIC=false
# COMFYUI_HIGH_RAM=false
# COMFYUI_VERBOSE_DEBUG=false
# COMFYUI_INSTALL_NODE_REQUIREMENTS=false   # pip install requirements.txt of each custom node at start
# COMFYUI_CHOWN_DATA=false                  # recursively chown /data to PUID:PGID at start
# COMFYUI_ARGS=                             # any extra raw ComfyUI arguments

# Any PyTorch/CUDA variable passes straight through, e.g.:
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
