# --- Compose settings ---
COMFYUI_TAG=latest          # latest, or a ComfyUI version such as 0.38.0
COMFYUI_HOST_PORT=8188
COMFYUI_DATA=./data         # models, custom_nodes, input, output, user settings live here
PUID=1000
PGID=1000
# NVIDIA_VISIBLE_DEVICES=all

# --- ComfyUI settings (all optional) ---
# COMFYUI_LISTEN=0.0.0.0
# COMFYUI_PORT=8188                 # in-container port; keep in sync with the compose port mapping
# COMFYUI_CPU=auto                  # auto | true | false
# COMFYUI_VRAM_MODE=                # gpu-only | highvram | normalvram | lowvram | novram
# COMFYUI_CUDA_DEVICE=              # e.g. 0 or 0,1
# COMFYUI_RESERVE_VRAM=             # GB to keep free
# COMFYUI_ATTENTION=                # pytorch | split | quad | sage | flash | auto (-sage image default)
# COMFYUI_PREVIEW_METHOD=           # none | auto | latent2rgb | taesd
# COMFYUI_FAST=                     # e.g. fp16_accumulation (see `--fast` upstream)
# COMFYUI_CACHE_LRU=
# COMFYUI_MAX_UPLOAD_SIZE=100       # MB
# COMFYUI_CORS_ORIGIN=
# COMFYUI_TLS_KEYFILE=
# COMFYUI_TLS_CERTFILE=
# COMFYUI_EXTRA_MODEL_PATHS_CONFIG=
# COMFYUI_ENABLE_MANAGER=true
# COMFYUI_FORCE_FP16=false
# COMFYUI_FORCE_FP32=false
# COMFYUI_DISABLE_SMART_MEMORY=false
# COMFYUI_DISABLE_CUDA_MALLOC=false
# COMFYUI_DETERMINISTIC=false
# COMFYUI_HIGH_RAM=false
# COMFYUI_VERBOSE_DEBUG=false
# COMFYUI_INSTALL_NODE_REQUIREMENTS=false   # pip install requirements.txt of each custom node at start
# COMFYUI_CHOWN_DATA=false                  # recursively chown /data to PUID:PGID at start
# COMFYUI_ARGS=                             # any extra raw ComfyUI arguments

# --- AMD / ROCm (the -rocm-gfx1151 image sets sensible Strix Halo defaults; override here) ---
# COMFYUI_DISABLE_MMAP=true         # on in the ROCm image: avoids very slow/hanging loads above 64 GB
# COMFYUI_BF16_VAE=true             # on in the ROCm image: avoids OOM while decoding
# COMFYUI_CACHE_NONE=false          # true = reload models each run, less unified-memory pressure
# HSA_OVERRIDE_GFX_VERSION=11.5.1
# HSA_ENABLE_SDMA=0
# HSA_USE_SVM=0
# HIP_VISIBLE_DEVICES=0
# PYTORCH_HIP_ALLOC_CONF=expandable_segments:True

# --- Intel Arc / XPU (the -xpu image; see "Intel Arc" in the README) ---
# COMFYUI_ONEAPI_DEVICE_SELECTOR=level_zero:0   # pick one GPU on a multi-GPU host (index from torch.xpu)
# COMFYUI_CONTAINER_NAME=comfyui                # docker-compose.xpu.yml only: unique name per instance
# SYCL_CACHE_DIR=/data/cache/sycl               # JIT kernel caches (set in the image; kept on the volume)
# NEO_CACHE_DIR=/data/cache/neo

# --- Hugging Face (used by the `hf` CLI and by nodes that download models) ---
# HF_TOKEN=hf_...                           # needed for gated/private models
# HF_ENDPOINT=https://huggingface.co        # set to a mirror if you use one

# --- Bundled and preloaded custom nodes ---
# COMFYUI_BUNDLED_NODES=all                 # all | none | comma list: comfier_agent,ComfyUI-VideoHelperSuite
# COMFYUI_PRELOAD_NODES=                    # git URLs (optionally URL@ref), cloned into custom_nodes on first start

# --- Comfier agent (bundled; idle until COMFIER_URL and COMFIER_API_KEY are set) ---
# COMFIER_URL=https://comfier.example.com
# COMFIER_API_KEY=cmf_...

# Any PyTorch/CUDA variable passes straight through, e.g.:
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
